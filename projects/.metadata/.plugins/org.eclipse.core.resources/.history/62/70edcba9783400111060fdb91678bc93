#include <stdint.h>

#define RCC_AHB1ENR     0x40023830
#define GPIOA_MODER     0x40020000
#define GPIOA_ODR       0x40020014
#define GPIOA_IDR		0x40020010
#define GPIOA_PUPDR		0x4002000C

int main(void)
{

	uint32_t* pRCC_AHB1ENR = (uint32_t*)RCC_AHB1ENR;
    uint32_t* pGPIOA_MODER = (uint32_t*)GPIOA_MODER;
    uint32_t* pGPIOA_ODR = (uint32_t*)GPIOA_ODR;
    uint32_t* pGPIOA_IDR = (uint32_t*)GPIOA_IDR;
    uint32_t* pGPIOA_PUPDR = (uint32_t*)GPIOA_PUPDR;


    // Enable GPIOA clock (bit 0)
    *pRCC_AHB1ENR |= (1 << 0);

    // Set PA1 to output mode (bits 3:2 = 01)
    *pGPIOA_MODER |= (1 << 2);

    //PA0 is already in input mode


    //enable pull down on pa0 (0 volt when no current)
    *pGPIOA_PUPDR |= (1 << 1);






    for(;;) {
        // Wait for button press (0 → 1)
        if (*pGPIOA_IDR & 1) {
            // Toggle buzzer
            *pGPIOA_ODR ^= (1 << 1);

            // Wait for button release (1 → 0)
            while (*pGPIOA_IDR & 1);
        }
    }

}
