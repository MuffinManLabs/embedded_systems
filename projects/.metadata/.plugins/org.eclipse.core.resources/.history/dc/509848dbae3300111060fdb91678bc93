#include <stdint.h>

//enable rcc
#define RCC_AHB1ENR 	0x40023830

//port d pin 13 to output mode
#define GPIOD_MODER 	0x40020C00

//output a voltage to a pin
#define GPIOD_ODR 		0x40020C14




int main(void)
{
	//enable the GPIOD clock
	uint32_t* pRCC_AHB1ENR = (uint32_t*)RCC_AHB1ENR;
	*pRCC_AHB1ENR |= (1<<3);

	//change GPIOD pin 13 to output mode (cpu will write to the led through the GPIO pin pd13)
	uint32_t* pGPIOD_MODER = (uint32_t*)GPIOD_MODER;
	*pGPIOD_MODER |= (1<<26);

	//large loop that turns led on and off using the GPIOx_ODR (output data register)
	uint32_t* pGPIOD_ODR = (uint32_t*)GPIOD_ODR;
	*pGPIOD_ODR |= (1<<13);

	for(;;)
	{
	    *pGPIOD_ODR |= (1 << 13);
	    for(uint32_t i = 0; i < 500000; i++);
	    *pGPIOD_ODR &= ~(1 << 13);
	    for(uint32_t i = 0; i < 500000; i++);
	}
}
