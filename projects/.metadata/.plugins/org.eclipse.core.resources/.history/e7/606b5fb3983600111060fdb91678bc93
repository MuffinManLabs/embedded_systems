	volatile uint32_t *pTIM3_PSC   = (volatile uint32_t *)TIM3_PSC;

	//the limit the counter can reach (smaller limit means higher frequency becasue counter would restart more often)
	volatile uint32_t *pTIM3_ARR   = (volatile uint32_t *)TIM3_ARR;

	//to set the threshold that the counter reaches until it has to output a low signal instead of high
	volatile uint32_t *pTIM3_CCR1  = (volatile uint32_t *)TIM3_CCR1;

	// Decides: CNT < CCR → HIGH
	//CNT ≥ CCR → LOW    (change ocm1M mode bit)
	volatile uint32_t *pTIM3_CCMR1 = (volatile uint32_t *)TIM3_CCMR1;




	//counter enable (start counting)
	volatile uint32_t *pTIM3_CR1   = (volatile uint32_t *)TIM3_CR1;




	//the gate that allows the high/low signal from tim to get to the pin pa6 (change CC1E bit)
	volatile uint32_t *pTIM3_CCER  = (volatile uint32_t *)TIM3_CCER;




	//enable clock for GPIOA
	*pAHB1ENR |= (1 << 0);

	//change pa6 to alternate function mode (to use TIM3)
