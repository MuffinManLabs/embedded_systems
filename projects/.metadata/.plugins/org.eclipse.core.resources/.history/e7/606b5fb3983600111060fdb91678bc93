	// Decides: CNT < CCR → HIGH
	//CNT ≥ CCR → LOW    (change oc1M mode bit)
	*pTIM3_CCMR1 |= (0x3 << 5);


	//enable the output of signal to the pin
	*pTIM3_CCER |= (1<<0);


	//turn on counter
	*pTIM3_CR1 |= (1 << 0);











