	//set pa6 to alternate function (TIM3 MODE)
	*pGPIOA_AFRL |= (1 << 25);



	//enable clock for tim3
	*pAPB1ENR |= (1<<1);

	//lower the frequency that goes from HSI to TIM3 from 16mhz to 1mhz (1 million tics per second)
	*pTIM3_PSC = 15;

	//set the limit the counter can reach (counter will reset 1000 times before reaching a million tics)
	*pTIM3_ARR  = 500;

	//then set the threshold that the count should reach until it is set to 0volts
