/*
 * ============================================================================
 *  TEMPORARY OLED ANIMATION  --  DELETE WHEN PROPER DRIVERS ARE BUILT
 * ============================================================================
 *
 *  Purpose:
 *      Drive the SSD1306 with a real-time animation: three rectangles bounce
 *      around the screen at different speeds, redrawing every ~25 ms.
 *
 *  Speed note:
 *      Bumped I2C1 to 400 kHz Fast Mode so the 1025-byte framebuffer push
 *      takes ~25 ms instead of ~92 ms. That gives ~40 FPS animation instead
 *      of ~10 FPS. The CCR/TRISE math for Fast Mode is slightly different
 *      from Standard Mode - we'll cover it properly in the real driver.
 *
 *  Throwaway code reminder:
 *      Same caveats as the bus scanner / OLED test - raw register macros,
 *      everything in one file. NOT the style for the real driver.
 * ============================================================================
 */

#include "stm32f407xx.h"
#include "rcc.h"
#include "systick.h"
#include "usart2.h"
#include <stdint.h>


/* ----- I2C1 register access (temporary, raw pointer macros) -------------- */
#define I2C1_BASE          0x40005400UL
#define I2C1_CR1           (*(volatile uint32_t *)(I2C1_BASE + 0x00U))
#define I2C1_CR2           (*(volatile uint32_t *)(I2C1_BASE + 0x04U))
#define I2C1_DR            (*(volatile uint32_t *)(I2C1_BASE + 0x10U))
#define I2C1_SR1           (*(volatile uint32_t *)(I2C1_BASE + 0x14U))
#define I2C1_SR2           (*(volatile uint32_t *)(I2C1_BASE + 0x18U))
#define I2C1_CCR           (*(volatile uint32_t *)(I2C1_BASE + 0x1CU))
#define I2C1_TRISE         (*(volatile uint32_t *)(I2C1_BASE + 0x20U))

#define I2C_CR1_PE         (1U << 0)
#define I2C_CR1_START      (1U << 8)
#define I2C_CR1_STOP       (1U << 9)
#define I2C_CR1_SWRST      (1U << 15)

#define I2C_CCR_FS         (1U << 15)   /* Fast mode select                  */

#define I2C_SR1_SB         (1U << 0)
#define I2C_SR1_ADDR       (1U << 1)
#define I2C_SR1_BTF        (1U << 2)
#define I2C_SR1_TXE        (1U << 7)
#define I2C_SR1_AF         (1U << 10)

#define I2C_SR2_BUSY       (1U << 1)

#define I2C_TIMEOUT_MS     50U


/* ----- SSD1306 protocol constants ---------------------------------------- */

#define SSD1306_I2C_ADDR        0x3CU
#define SSD1306_CTRL_CMD        0x00U
#define SSD1306_CTRL_DATA       0x40U

#define SSD1306_WIDTH           128
#define SSD1306_HEIGHT          64
#define SSD1306_PAGES           (SSD1306_HEIGHT / 8)
#define SSD1306_FB_BYTES        (SSD1306_WIDTH * SSD1306_PAGES) /* 1024 */


/* ============================================================================
 *  Bring-up: GPIO + I2C1 (Fast Mode 400 kHz)
 * ============================================================================ */
static void i2c1_gpio_init(void)
{
    RCC->AHB1ENR |= (1U << 1);

    GPIOB->MODER &= ~((3U << (6 * 2)) | (3U << (7 * 2)));
    GPIOB->MODER |=  ((2U << (6 * 2)) | (2U << (7 * 2)));

    GPIOB->OTYPER  |= (1U << 6) | (1U << 7);
    GPIOB->OSPEEDR |= (3U << (6 * 2)) | (3U << (7 * 2));
    GPIOB->PUPDR   &= ~((3U << (6 * 2)) | (3U << (7 * 2)));

    GPIOB->AFRL &= ~((0xFU << (6 * 4)) | (0xFU << (7 * 4)));
    GPIOB->AFRL |=  ((4U   << (6 * 4)) | (4U   << (7 * 4)));
}

static void i2c1_peripheral_init_fast_mode(void)
{
    RCC->APB1ENR |= (1U << 21);

    I2C1_CR1 |=  I2C_CR1_SWRST;
    I2C1_CR1 &= ~I2C_CR1_SWRST;

    I2C1_CR2 = 42U;                              /* APB1 = 42 MHz             */

    /* Fast Mode at 400 kHz, DUTY=0:
     *   SCL period = 3 * CCR * T_pclk
     *   CCR = APB1 / (3 * SCL) = 42_000_000 / (3 * 400_000) = 35
     */
    I2C1_CCR = I2C_CCR_FS | 35U;

    /* TRISE for Fast Mode: max rise = 300 ns
     *   TRISE = (300 ns / 23.8 ns) + 1 = 13.6 + 1 ≈ 14
     */
    I2C1_TRISE = 14U;

    I2C1_CR1 |= I2C_CR1_PE;
}


/* ============================================================================
 *  I2C1 master transmit (same as oled test)
 * ============================================================================ */
static int i2c1_write(uint8_t address, const uint8_t *data, uint32_t len)
{
    uint32_t start_ms;

    start_ms = systick_get_ms();
    while ((I2C1_SR2 & I2C_SR2_BUSY) != 0U)
    {
        if ((systick_get_ms() - start_ms) >= I2C_TIMEOUT_MS) { return -1; }
    }

    I2C1_CR1 |= I2C_CR1_START;
    start_ms = systick_get_ms();
    while ((I2C1_SR1 & I2C_SR1_SB) == 0U)
    {
        if ((systick_get_ms() - start_ms) >= I2C_TIMEOUT_MS) { return -1; }
    }

    I2C1_DR = (uint32_t)((uint32_t)address << 1);
    start_ms = systick_get_ms();
    while ((I2C1_SR1 & (I2C_SR1_ADDR | I2C_SR1_AF)) == 0U)
    {
        if ((systick_get_ms() - start_ms) >= I2C_TIMEOUT_MS)
        {
            I2C1_CR1 |= I2C_CR1_STOP;
            return -1;
        }
    }

    if ((I2C1_SR1 & I2C_SR1_AF) != 0U)
    {
        I2C1_SR1 &= ~I2C_SR1_AF;
        I2C1_CR1 |= I2C_CR1_STOP;
        return -1;
    }

    (void)I2C1_SR1;
    (void)I2C1_SR2;

    for (uint32_t i = 0U; i < len; i++)
    {
        start_ms = systick_get_ms();
        while ((I2C1_SR1 & I2C_SR1_TXE) == 0U)
        {
            if ((systick_get_ms() - start_ms) >= I2C_TIMEOUT_MS)
            {
                I2C1_CR1 |= I2C_CR1_STOP;
                return -1;
            }
        }
        I2C1_DR = data[i];
    }

    start_ms = systick_get_ms();
    while ((I2C1_SR1 & I2C_SR1_BTF) == 0U)
    {
        if ((systick_get_ms() - start_ms) >= I2C_TIMEOUT_MS)
        {
            I2C1_CR1 |= I2C_CR1_STOP;
            return -1;
        }
    }

    I2C1_CR1 |= I2C_CR1_STOP;
    return 0;
}


/* ----- SSD1306 init + addressing window (same as oled test) -------------- */

static const uint8_t ssd1306_init_seq[] =
{
    SSD1306_CTRL_CMD,
    0xAE, 0xD5, 0x80, 0xA8, 0x3F, 0xD3, 0x00, 0x40,
    0x8D, 0x14, 0x20, 0x00, 0xA1, 0xC8, 0xDA, 0x12,
    0x81, 0xCF, 0xD9, 0xF1, 0xDB, 0x40, 0xA4, 0xA6,
    0x2E, 0xAF
};

static const uint8_t ssd1306_addr_window[] =
{
    SSD1306_CTRL_CMD,
    0x21, 0x00, 0x7F,
    0x22, 0x00, 0x07
};


/* ============================================================================
 *  Framebuffer + drawing primitives
 *
 *  Framebuffer layout: framebuffer[0] is the SSD1306 data control byte
 *  (0x40). framebuffer[1..1024] is the 128*8 byte pixel buffer in horizontal
 *  addressing mode.
 *
 *  For set_pixel: each byte is 8 vertical pixels in a "page". The byte at
 *  (page=y/8, col=x) lives at framebuffer[1 + page*128 + col], and bit
 *  (y & 7) within that byte controls pixel (x, y).
 * ============================================================================ */

static uint8_t framebuffer[1U + SSD1306_FB_BYTES];

static void fb_clear(void)
{
    framebuffer[0] = SSD1306_CTRL_DATA;
    for (int i = 1; i <= SSD1306_FB_BYTES; i++)
    {
        framebuffer[i] = 0x00U;
    }
}

static inline void fb_set_pixel(int x, int y)
{
    if ((x < 0) || (x >= SSD1306_WIDTH) || (y < 0) || (y >= SSD1306_HEIGHT))
    {
        return;
    }
    int page  = y / 8;
    int bit   = y & 7;
    int index = 1 + (page * SSD1306_WIDTH) + x;
    framebuffer[index] |= (uint8_t)(1U << bit);
}

static void fb_draw_rect_filled(int x, int y, int w, int h)
{
    for (int dy = 0; dy < h; dy++)
    {
        for (int dx = 0; dx < w; dx++)
        {
            fb_set_pixel(x + dx, y + dy);
        }
    }
}


/* ============================================================================
 *  Bouncing box state
 * ============================================================================ */
typedef struct {
    int x;
    int y;
    int dx;
    int dy;
    int w;
    int h;
} box_t;

#define BOX_COUNT  3

static box_t boxes[BOX_COUNT] = {
    /* big slow box                    */ {  4,  4,  1,  1, 16, 16 },
    /* medium box, different angle     */ { 60, 30, -2,  1, 10, 10 },
    /* small fast box                  */ { 90,  8,  2, -2,  6,  6 }
};

static void boxes_update_and_draw(void)
{
    for (int i = 0; i < BOX_COUNT; i++)
    {
        box_t *b = &boxes[i];

        /* Draw at current position */
        fb_draw_rect_filled(b->x, b->y, b->w, b->h);

        /* Move */
        b->x += b->dx;
        b->y += b->dy;

        /* Bounce off the walls */
        if (b->x <= 0)
        {
            b->x = 0;
            b->dx = -b->dx;
        }
        if ((b->x + b->w) >= SSD1306_WIDTH)
        {
            b->x = SSD1306_WIDTH - b->w;
            b->dx = -b->dx;
        }
        if (b->y <= 0)
        {
            b->y = 0;
            b->dy = -b->dy;
        }
        if ((b->y + b->h) >= SSD1306_HEIGHT)
        {
            b->y = SSD1306_HEIGHT - b->h;
            b->dy = -b->dy;
        }
    }
}


/* ============================================================================
 *  main
 * ============================================================================ */
#define FRAME_PERIOD_MS    25U     /* ~40 FPS                                */

int main(void)
{
    rcc_init_clock_168mhz();
    systick_init();
    usart2_init();

    usart2_send_string("\r\n--- OLED animation ---\r\n");

    i2c1_gpio_init();
    i2c1_peripheral_init_fast_mode();
    delay_ms(10);

    if (i2c1_write(SSD1306_I2C_ADDR,
                   ssd1306_init_seq,
                   sizeof(ssd1306_init_seq)) != 0)
    {
        usart2_send_string("FAIL: SSD1306 init\r\n");
        while (1) { /* halt */ }
    }

    usart2_send_string("Animation running.\r\n");

    uint32_t last_frame_ms = 0U;

    while (1)
    {
        uint32_t now_ms = systick_get_ms();

        if ((now_ms - last_frame_ms) >= FRAME_PERIOD_MS)
        {
            last_frame_ms = now_ms;

            /* Build next frame */
            fb_clear();
            boxes_update_and_draw();

            /* Reset addressing window every frame so the cursor wraps back
             * to (0,0) cleanly. Cheap, ~1 ms over 400 kHz I2C. */
            (void)i2c1_write(SSD1306_I2C_ADDR,
                             ssd1306_addr_window,
                             sizeof(ssd1306_addr_window));

            /* Push the framebuffer */
            (void)i2c1_write(SSD1306_I2C_ADDR,
                             framebuffer,
                             sizeof(framebuffer));
        }
    }
}
